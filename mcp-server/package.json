{
  "name": "@tim0_12432/hotkeyless-ahk-mcp-server",
  "version": "9.9.9",
  "mcpName": "io.github.tim0-12432/HotkeylessAHK-mcp-skill",
  "private": false,
  "description": "MCP server for Hotkeyless AHK HTTP API.",
  "keywords": [
    "MCP",
    "Agent Skills",
    "Auto Hotkey",
    "AHK",
    "Hotkeyless AHK"
  ],
  "author": {
    "name": "Tim0_12432",
    "url": "https://github.com/tim0-12432"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim0-12432/HotkeylessAHK-mcp-skill.git"
  },
  "bugs": {
    "url": "https://github.com/tim0-12432/HotkeylessAHK-mcp-skill/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hotkeyless-ahk-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json",
    "build": "vite build && npm run copy",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "publish:mcp": "../mcp-publisher.exe publish",
    "copy": "node -e \"import('node:fs').then((fs) => {fs.copyFileSync('../LICENSE.md', 'LICENSE.md');fs.copyFileSync('../README.md', 'README.md')})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "25.5.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-dts": "5.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.0.0",
      "onFail": "download"
    }
  }
}
